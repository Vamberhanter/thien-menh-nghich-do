# Safe to ship in the client — Realtime Presence + Broadcast only.
# Never put SUPABASE_SECRET_KEY in any Vite-exposed variable.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Chỉ dùng cho tools/upload-game-assets.mjs, KHÔNG có tiền tố VITE_ nên Vite
# không nhúng vào bundle. Bỏ trống nếu bucket game-assets đã mở policy cho anon.
SUPABASE_SERVICE_ROLE_KEY=
