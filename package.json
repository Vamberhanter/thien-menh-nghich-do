{
  "name": "thien-menh-nghich-do",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "test": "vitest run",
    "preview": "vite preview",
    "build:nhuyen": "node tools/build-nhuyen-atlas.mjs",
    "inspect:nhuyen": "node tools/extract-nhuyen.mjs --report",
    "measure:nhuyen": "node tools/extract-nhuyen.mjs --measure",
    "dump:nhuyen": "node tools/extract-nhuyen.mjs --dump .tmp/nhuyen-frames",

    "gen:placeholder": "node tools/generate-lin-yuan-sprites.mjs",
    "env:manaseed": "node tools/build-manaseed-env.mjs",
    "env:monsters": "node tools/build-monsters.mjs",
    "env:items": "node tools/build-farm-items.mjs && node tools/build-catalog-icons.mjs",
    "env:farm": "node tools/build-farm-env.mjs && node tools/build-farm-items.mjs",
    "env:catalog-icons": "node tools/build-catalog-icons.mjs",
    "env:weapons": "node tools/build-weapons.mjs",
    "env:resources": "node tools/build-world-resources.mjs && node tools/build-farm-env.mjs && node tools/build-farm-items.mjs && node tools/build-catalog-icons.mjs",
    "measure:stride": "node tools/measure-stride.mjs walk_side run_side walk_down walk_up",
    "analyse:cycle": "node tools/analyse-cycle.mjs walk_side run_side walk_down walk_up",
    "build:huyetlang": "node tools/build-huyetlang-atlas.mjs",
    "inspect:huyetlang": "node tools/extract-huyetlang.mjs --report",
    "measure:huyetlang": "node tools/extract-huyetlang.mjs --measure",
    "dump:huyetlang": "node tools/extract-huyetlang.mjs --dump .tmp/huyetlang-frames",
    "cuts:huyetlang": "node tools/extract-huyetlang.mjs --preview .tmp/huyetlang-cuts",
    "build:kiemtien": "node tools/build-kiemtien-atlas.mjs",
    "dump:kiemtien": "node tools/build-kiemtien-atlas.mjs --dump",
    "preview:kiemtien": "node tools/preview-atlas.mjs public/assets/characters/kiemtien/atlas/kiemtien.json .tmp/kiemtien-atlas.png",
    "build:miku": "node tools/build-miku-atlas.mjs",
    "dump:miku": "node tools/build-miku-atlas.mjs --dump",
    "preview:miku": "node tools/preview-atlas.mjs public/assets/characters/miku/atlas/miku.json .tmp/miku-atlas.png",
    "build:wukong": "node tools/build-wukong-atlas.mjs",
    "inspect:wukong": "node tools/extract-wukong.mjs --report",
    "measure:wukong": "node tools/extract-wukong.mjs --measure",
    "dump:wukong": "node tools/extract-wukong.mjs --dump .tmp/wukong-frames",
    "cuts:wukong": "node tools/extract-wukong.mjs --preview .tmp/wukong-cuts",
    "inspect:boss": "node tools/extract-boss.mjs --report",
    "dump:boss": "node tools/extract-boss.mjs --dump .tmp/boss-frames",
    "check:ai": "node tools/check-enemy-ai.mjs",
    "check:atlas": "node tools/check-atlas.mjs public/assets/characters/nhuyen/atlas/nhuyen.json && node tools/check-atlas.mjs public/assets/characters/huyetlang/atlas/huyetlang.json && node tools/check-atlas.mjs public/assets/boss/boss1/atlas/boss1.json && node tools/check-atlas.mjs public/assets/characters/wukong/atlas/wukong.json",
    "preview:atlas": "node tools/preview-atlas.mjs public/assets/characters/huyetlang/atlas/huyetlang.json .tmp/huyetlang-atlas.png",
    "upload:characters": "node tools/upload-game-assets.mjs characters",
    "upload:kiemtien": "node tools/upload-game-assets.mjs kiemtien",
    "upload:vfx": "node tools/upload-game-assets.mjs vfx",
    "upload:boss": "node tools/upload-game-assets.mjs boss",
    "upload:assets": "node tools/upload-game-assets.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.115.0",
    "phaser": "^3.87.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^26.4.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "sharp": "^0.35.4",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vitest": "^2.1.9"
  }
}
